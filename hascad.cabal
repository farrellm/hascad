cabal-version:      3.14
name:               hascad
version:            0.1.0.0
synopsis:           A Haskell DSL for generating OpenSCAD models
description:
    A typed, dimension-indexed embedded language for describing solid models,
    rendered to OpenSCAD source.  Repeated geometry is automatically hoisted
    into shared OpenSCAD modules.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Matthew Farrell
maintainer:         farrellm@alum.mit.edu
category:           Graphics
build-type:         Simple
extra-doc-files:    CHANGELOG.md

flag werror
    description: Turn warnings into errors.  Enabled in CI.
    default:     False
    manual:      True

common warnings
    ghc-options: -Wall
    if flag(werror)
        ghc-options: -Werror

common lang
    build-depends:      base ^>=4.21.2.0
                      , relude
    mixins:             base hiding (Prelude)
                      , relude (Relude as Prelude)
                      , relude
    default-language:   GHC2024
    default-extensions: OverloadedStrings
                        TypeFamilies

library
    import:           warnings, lang
    exposed-modules:  HasCad
                      HasCad.Boolean
                      HasCad.Dimension
                      HasCad.Facet
                      HasCad.Gear
                      HasCad.Model
                      HasCad.Monad
                      HasCad.Primitive
                      HasCad.Render
                      HasCad.Transform
                      HasCad.Vector
    build-depends:    containers
                    , effectful-core
                    , prettyprinter
                    , text
    hs-source-dirs:   src

executable hascad
    import:           warnings, lang
    main-is:          Main.hs
    other-modules:    Example
    build-depends:    hascad
                    , text
    hs-source-dirs:   app, examples

test-suite hascad-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Example
                      HasCad.GoldenSpec
                      HasCad.RenderSpec
    build-depends:    hascad
                    , hspec
                    , text
    build-tool-depends: hspec-discover:hspec-discover
    hs-source-dirs:   test, examples
